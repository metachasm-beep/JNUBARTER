{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/types/three.d.ts",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "superpowers-main",
    "antigravity-awesome-skills-main",
    "antigravity-skills-main",
    "awesome-design-md-main",
    "everything-claude-code-main",
    "get-shit-done-for-antigravity-main",
    "react-bits-main",
    "shadcnui-main",
    "stitch-skills-main",
    "v0-skills-main",
    "shadcn-skills-main"
  ]
}
