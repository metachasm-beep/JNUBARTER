// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  bio           String?
  school        String?   // E.g. SIS, SLL&CS, SSS
  hostel        String?   // E.g. Tapti, Mahi-Mandavi
  roomNumber    String?   // E.g. 242
  program       String?   // E.g. PhD, MA, BA
  year          String?   
  dob           DateTime? // Date of Birth
  gender        String?   
  phone         String?   
  skills        String[]  // Array of skill tags
  interests     String[]  // Things they want to learn
  reputation    Int       @default(0)
  isVerified    Boolean   @default(false)
  role          UserRole  @default(USER)
  isSuspended   Boolean   @default(false)
  idCardUrl     String?   // URL for JNU ID card photo
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  listings        Listing[]
  swapsInitiated  Swap[]         @relation("Initiator")
  swapsReceived   Swap[]         @relation("Receiver")
  vouchesSent     Vouch[]        @relation("VouchSender")
  vouchesReceived Vouch[]        @relation("VouchReceiver")
  notifications   Notification[]
  pushSubscriptions PushSubscription[]
  auditLogs       AuditLog[]
  verificationReports VerificationReport[]
  multiSwapParticipations MultiSwapParticipant[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

model UsageLog {
  id        String   @id @default(cuid())
  feature   String
  tokens    Int
  cost      Float
  metadata  Json?
  createdAt DateTime @default(now())
}

model SystemConfig {
  id        String   @id @default("GLOBAL")
  config    Json
  updatedAt DateTime @updatedAt
}

model VerificationReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  status    VerificationStatus
  findings  String?
  evidence  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

enum VerificationStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Listing {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  type          ListingType // OFFER or WANT
  category      Category    @default(SERVICE) // SERVICE or COMMODITY
  title         String
  description   String
  videoUrl      String?
  images        String[]    // Support for commodity photos
  tags          String[]
  effortEstimate EffortEstimate? // Only for services
  condition     String?     // Only for commodities (E.g. New, Used)
  embedding     Unsupported("vector(768)")? 
  status        ListingStatus @default(PENDING)
  isFlagged     Boolean   @default(false)
  flagReason    String?
  isSystem      Boolean   @default(false) // For dummy/seeding entries
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([type])
  @@index([category])
  @@index([status])
  @@index([isFlagged])

  swapItems     SwapItem[]
  multiSwapParticipations MultiSwapParticipant[]
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingType {
  OFFER
  WANT
}

enum Category {
  SERVICE
  COMMODITY
}

enum EffortEstimate {
  LOW
  MEDIUM
  HIGH
}

model Swap {
  id            String    @id @default(cuid())
  initiatorId   String
  initiator     User      @relation("Initiator", fields: [initiatorId], references: [id])
  receiverId    String
  receiver      User      @relation("Receiver", fields: [receiverId], references: [id])
  status        SwapStatus @default(PROPOSED)
  expiresAt     DateTime  @default(dbgenerated("NOW() + INTERVAL '72 hours'"))
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([initiatorId])
  @@index([receiverId])
  @@index([status])

  items         SwapItem[]
  messages      Message[]
  vouch         Vouch?
  notifications Notification[]
}

enum SwapStatus {
  PROPOSED
  COUNTERED
  ACCEPTED
  EXECUTED
  CANCELLED
}

model MultiSwap {
  id            String    @id @default(cuid())
  status        SwapStatus @default(PROPOSED)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  participants  MultiSwapParticipant[]
}

model MultiSwapParticipant {
  id            String    @id @default(cuid())
  multiSwapId   String
  multiSwap     MultiSwap @relation(fields: [multiSwapId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  givingListingId String
  givingListing   Listing @relation(fields: [givingListingId], references: [id])
  receivingTag  String    
  hasConfirmed  Boolean   @default(false)

  @@index([multiSwapId])
  @@index([userId])
  @@index([givingListingId])
}

model SwapItem {
  id            String    @id @default(cuid())
  swapId        String
  swap          Swap      @relation(fields: [swapId], references: [id])
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id])
  addedById     String

  @@index([swapId])
  @@index([listingId])
}

model Message {
  id            String    @id @default(cuid())
  swapId        String
  swap          Swap      @relation(fields: [swapId], references: [id])
  senderId      String
  content       String
  createdAt     DateTime  @default(now())

  @@index([swapId])
  @@index([senderId])
}

model Vouch {
  id            String    @id @default(cuid())
  swapId        String    @unique
  swap          Swap      @relation(fields: [swapId], references: [id])
  senderId      String
  sender        User      @relation("VouchSender", fields: [senderId], references: [id])
  receiverId    String
  receiver      User      @relation("VouchReceiver", fields: [receiverId], references: [id])
  content       String
  skillsVouched String[]
  createdAt     DateTime  @default(now())

  @@index([senderId])
  @@index([receiverId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  refId     String           // swapId for VOUCH_PROMPT
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  swap      Swap?            @relation(fields: [refId], references: [id])

  @@index([userId])
  @@index([refId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

enum NotificationType {
  VOUCH_PROMPT
  SWAP_MATCHED
  SWAP_EXPIRED
}
